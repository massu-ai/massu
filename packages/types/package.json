{
  "name": "@massu/types",
  "version": "1.12.0",
  "description": "Shared TypeScript types for Massu — single source of truth for tier names, tool names, billing plan IDs, and marketing counts. Re-exported by @massu/core and the Vercel website.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "cp ../../LICENSE ./LICENSE && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/massu-ai/massu.git",
    "directory": "packages/types"
  },
  "homepage": "https://massu.ai",
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE"
}
