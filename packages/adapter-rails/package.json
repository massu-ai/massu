{
  "name": "@massu/adapter-rails",
  "version": "1.1.0",
  "description": "Massu first-party adapter for Ruby on Rails — Tree-sitter AST detection of routes, namespaces, and root controllers in config/routes.rb",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@massu/core": ">=2.0.0",
    "web-tree-sitter": "~0.25.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/massu-ai/massu.git",
    "directory": "packages/adapter-rails"
  },
  "license": "BSL-1.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "massu-adapter",
    "rails"
  ],
  "massu-adapter": true,
  "massu-adapter-api-version": "1"
}
