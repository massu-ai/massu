{
  "name": "@massu/adapter-spring",
  "version": "1.1.0",
  "description": "Massu first-party adapter for Spring (Java) \u2014 Tree-sitter AST detection of @RestController, @RequestMapping, @GetMapping/@PostMapping/etc. annotations in Spring Boot codebases",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepublishOnly": "npm run build && bash ../../scripts/npm-publish-guard.sh \"$PWD\""
  },
  "peerDependencies": {
    "@massu/core": ">=2.0.0",
    "web-tree-sitter": "~0.25.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/massu-ai/massu.git",
    "directory": "packages/adapter-spring"
  },
  "license": "BSL-1.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "massu-adapter",
    "spring",
    "java",
    "spring-boot"
  ],
  "massu-adapter": true,
  "massu-adapter-api-version": "1"
}
